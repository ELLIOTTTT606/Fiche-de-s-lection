# ─────────────────────────────────────────────────────────────
# INVENIO — Variables d'environnement
# Copiez ce fichier en `.env` et remplissez les valeurs.
# ─────────────────────────────────────────────────────────────

# --- Baserow ---
BASEROW_API_URL=https://api.baserow.io
BASEROW_TOKEN=remplacez_par_votre_token

# IDs des tables Baserow (existantes)
BASEROW_TABLE_CLIENTS=939119
BASEROW_TABLE_CONTACTS_FV=939355
BASEROW_TABLE_CONTACTS_SOLUTION=939361
BASEROW_TABLE_OPTIONS=941070
BASEROW_TABLE_PRIX=939101

# IDs des tables Baserow (à créer — voir README §Baserow)
BASEROW_TABLE_DESIGNATION=
BASEROW_TABLE_PRESCRIPTION=
BASEROW_TABLE_LIBELLES=

# --- Maintenance ---
# Mot de passe simple pour accéder à la page Maintenance
MAINTENANCE_PASSWORD=changez_moi

# --- Frontend ---
# URL de l'API (laisser vide en production : même origine)
VITE_API_URL=
